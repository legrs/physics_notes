{
  "name": "physics-notes-build",
  "version": "1.0.0",
  "description": "Build script for physics_notes JSON",
  "scripts": {
    "build": "node scripts/build.js",
    "build:embed": "node scripts/build.js --embed",
    "build:embed-only": "node scripts/build.js --embed-only",
    "normalize:images": "node scripts/normalize-images.js",
    "normalize:images:check": "node scripts/normalize-images.js --check",
    "test": "node scripts/tests/run_all.js",
    "test:html": "node scripts/tests/html_syntax.js && node scripts/tests/html_stress.js",
    "test:data": "node scripts/tests/data_check.js && node physq/scripts/parity_check.js",
    "test:qa-images": "node scripts/normalize-images.js --check && node scripts/tests/qa_images_stress.js && node scripts/tests/data_check.js",
    "test:build": "node scripts/tests/data_check.js",
    "test:physq": "node scripts/tests/run_physq.js"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "dirlens": "latest"
  }
}